{
    "name": "noerd/modal",
    "description": "Open each livewire component in a modal window.",
    "type": "library",
    "version": "v0.4.0",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "laravel/framework": "^12.0 || ^13.0",
        "livewire/livewire": "^4.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.6 || ^11.1",
        "pestphp/pest": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "NoerdModal\\": "src/",
            "NoerdModal\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest --compact"
    },
    "minimum-stability": "stable",
    "extra": {
        "laravel": {
            "providers": [
                "NoerdModal\\Providers\\NoerdModalServiceProvider"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
